<!--
  Baseline-profile target overlay. The plugin creates nonMinifiedRelease dynamically.
  Keeps profiling and internal database APIs isolated from production release APKs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="io.github.davelewis360.ankidroid.m3expressive.permission.READ_WRITE_DATABASE"
        tools:node="remove" />

    <permission
        android:name="${applicationId}.permission.READ_WRITE_DATABASE"
        tools:node="remove" />

    <application>
        <provider
            android:name=".provider.CardContentProvider"
            tools:node="remove" />

        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <style name="Base.Theme.Light" parent="@style/Theme.Material3.Light.NoActionBar">
        <!-- Android colors: Material 3 Expressive tonal scheme -->
        <item name="colorPrimary">@color/m3_primary_light</item>
        <item name="colorPrimaryDark">@color/m3_on_primary_container_light</item>
        <item name="colorOnPrimary">@color/m3_on_primary_light</item>
        <item name="colorSurface">@color/m3_surface_light</item>
        <item name="colorOnSurface">@color/m3_on_surface_light</item>
        <item name="colorAccent">@color/m3_primary_light</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container_light</item>
        <item name="colorSecondary">@color/m3_secondary_light</item>
        <item name="colorOnSecondary">@color/m3_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container_light</item>
        <item name="colorTertiary">@color/m3_tertiary_light</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary_light</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container_light</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container_light</item>
        <item name="colorError">@color/m3_error_light</item>
        <item name="colorOnError">@color/m3_on_error_light</item>
        <item name="colorErrorContainer">@color/m3_error_container_light</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container_light</item>
        <item name="colorOutline">@color/m3_outline_light</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant_light</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant_light</item>

        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest_light</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high_light</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container_light</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low_light</item>

        <!-- M3 Expressive shape scale -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AnkiDroid.M3Expressive.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AnkiDroid.M3Expressive.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AnkiDroid.M3Expressive.Large</item>

        <item name="android:textColor">@color/text_color_light</item>
        <item name="android:textColorSecondary">@color/text_color_secondary_light</item>
        <item name="android:colorBackground">@color/m3_background_light</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="preferenceCategoryTitleTextColor">@color/m3_primary_light</item>
        <!-- Widget colors -->
        <item name="widgetColorActivated">?attr/colorPrimary</item>
        <!-- Navigation drawer theme -->
        <item name="navDrawerItemColor">@color/drawer_item_text_light</item>
        <item name="navDrawerItemBackgroundColor">@drawable/drawer_item_background_light</item>
        <!-- Menu -->
        <item name="actionOverflowMenuStyle">@style/OverflowMenuStyle</item>
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="spinnerStyle">@style/SpinnerStyle</item>
        <!-- Action bar styles: surface-toned expressive app bar -->
        <item name="appBarColor">@color/m3_surface_container_high_light</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionBarTextColor">@color/m3_on_surface_light</item>
        <item name="actionBarPopupTextColor">?android:attr/textColor</item>
        <item name="actionModeBackground">@color/m3_secondary_container_light</item>
        <!-- Tab layout -->
        <item name="tabLayoutBackgroundColor">@color/m3_surface_container_high_light</item>
        <item name="tabActiveIconColor">@color/m3_primary_light</item>
        <!-- Deck list colors and divider -->
        <item name="currentDeckBackground">@drawable/item_background_selected</item>
        <item name="currentDeckBackgroundColor">#ececec</item>
        <item name="focusedRowBackgroundColor">#ececec</item>
        <item name="dynDeckColor">#2222bb</item>
        <item name="deckDivider">@drawable/divider</item>
        <item name="expandRef">@drawable/ic_chevron_right_black</item>
        <item name="collapseRef">@drawable/ic_expand_more_black</item>
        <!-- Count colors -->
        <item name="newCountColor">@color/m3_new_count_light</item>
        <item name="learnCountColor">@color/m3_learn_count_light</item>
        <item name="reviewCountColor">@color/m3_review_count_light</item>
        <item name="buryCountColor">@color/disabled_gray_light</item>
        <item name="zeroCountColor">#66666666</item>
        <!-- Study Screen colors: expressive tonal containers -->
        <item name="againButtonBackground">@color/m3_again_container_light</item>
        <item name="hardButtonBackground">@color/m3_hard_container_light</item>
        <item name="goodButtonBackground">@color/m3_good_container_light</item>
        <item name="easyButtonBackground">@color/m3_easy_container_light</item>
        <item name="topBarColor">@color/m3_surface_container_high_light</item>
        <item name="maxTimerColor">@color/m3_error_light</item>
        <item name="answerButtonTextColor">@color/m3_on_primary_container_light</item>
        <item name="againButtonTextColor">@color/m3_on_again_container_light</item>
        <item name="hardButtonTextColor">@color/m3_on_hard_container_light</item>
        <item name="goodButtonTextColor">@color/m3_on_good_container_light</item>
        <item name="easyButtonTextColor">@color/m3_on_easy_container_light</item>

        <item name="alternativeBackgroundColor">@color/m3_surface_container_low_light</item>
        <item name="againTextColor">@color/m3_on_again_container_light</item>
        <item name="hardTextColor">@color/m3_on_hard_container_light</item>
        <item name="goodTextColor">@color/m3_on_good_container_light</item>
        <item name="easyTextColor">@color/m3_on_easy_container_light</item>
        <item name="againBackgroundColor">@color/m3_again_container_light</item>
        <item name="hardBackgroundColor">@color/m3_hard_container_light</item>
        <item name="goodBackgroundColor">@color/m3_good_container_light</item>
        <item name="easyBackgroundColor">@color/m3_easy_container_light</item>
        <item name="againIconColor">?againTextColor</item>
        <item name="hardIconColor">?hardTextColor</item>
        <item name="goodIconColor">?goodTextColor</item>
        <item name="easyIconColor">?easyTextColor</item>
        <!-- Study Screen button drawables -->
        <item name="showAnswerButtonBackground">@color/m3_primary_light</item>
        <item name="showAnswerColor">@color/m3_on_primary_light</item>
        <item name="againButtonRef">@drawable/footer_button_again</item>
        <item name="hardButtonRef">@drawable/footer_button_hard</item>
        <item name="goodButtonRef">@drawable/footer_button_good</item>
        <item name="easyButtonRef">@drawable/footer_button_easy</item>
        <item name="againButtonRippleRef">@drawable/footer_button_ripple</item>
        <item name="hardButtonRippleRef">@drawable/footer_button_ripple</item>
        <item name="goodButtonRippleRef">@drawable/footer_button_ripple</item>
        <item name="easyButtonRippleRef">@drawable/footer_button_ripple</item>
        <!-- Card Browser Colors -->
        <item name="cardBrowserDivider">#CCCCCC</item>
        <!-- Browser colors -->
        <item name="suspendedColor">#FFFFB2</item>
        <item name="buriedColor">#FFCE7C</item>
        <item name="selectedColor">#FFFFBB99</item>
        <item name="markedColor">#D9B2E9</item>
        <!-- Note editor colors -->
        <item name="duplicateColor">#fcc</item>
        <item name="editTextBackgroundColor">#EBCCCCCC</item>
        <item name="editTextHighlightColor">@color/material_light_blue_200</item>
        <item name="textInputOutlinedStyle">@style/TextInputSelectionColorFixStyle</item>
        <item name="toolbarBackgroundColor">#D6D7D7</item>
        <item name="toolbarIconColor">@color/black</item>
        <item name="buttonShadowColor">#FFAAAAAA</item>
        <item name="buttonRippleColor">#595959</item>
        <item name="buttonForegroundColor">#D6D7D7</item>
        <!-- FAB -->
        <item name="fab_normal">@color/m3_primary_container_light</item>
        <item name="fab_pressed">@color/m3_surface_variant_light</item>
        <!-- Images -->
        <item name="navDrawerImage">@drawable/nav_drawer_logo</item>
        <!-- Dialog styles -->
        <item name="android:listPreferredItemHeight">56dip</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>
        <item name="textAllCaps">false</item>
        <!--Custom Tabs colors-->
        <item name="customTabNavBarColor">@color/m3_primary_light</item>
        <item name="popupBackgroundColor">@color/m3_surface_container_low_light</item>
        <item name="overflowAndPopupMenuIconColor">#9e000000</item>
        <!-- StatusBar -->
        <item name="android:statusBarColor">@color/m3_surface_container_high_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Navbar -->
        <item name="android:navigationBarColor">@color/semi_transparent_black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="editTextDisabled">@color/material_grey_500</item>

        <!-- Snackbar. Attributes snackbarStyle, snackbarTextViewStyle and snackbarButtonStyle
             must be *all* present in a theme (or its parent) in order for the snackbar
             to pick up the proper layout that uses these attributes. -->
        <item name="snackbarStyle">@style/SnackbarStyle</item>
        <item name="snackbarTextViewStyle">@style/Widget.MaterialComponents.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/SnackbarButtonStyle</item>
        <item name="snackbarBackgroundTintColor">@color/material_grey_800</item>
        <item name="snackbarButtonTextColor">@color/material_light_blue_300</item>

        <!-- Introduction -->
        <item name="introductionLogoTransparent">#99FFFFFF</item>

        <!-- Widget styles -->
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Material3</item>
        <item name="sliderStyle">@style/SliderStyle</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.AnkiDroid</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AnkiDroid.AlertDialog</item>

        <!-- ProgressDialog-->
        <item name="dialogBackground">@color/white</item>

        <item name="checkMediaListBackground">@color/material_blue_grey_050</item>
        <item name="checkMediaListForeground">@color/material_grey_700</item>
        <item name="progressDialogButtonTextColor">@color/material_light_blue_500</item>
        <item name="tabStyle">@style/Widget.MaterialComponents.TabLayout</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>


        <item name="clozeColor">#0277BD</item>

        <item name="incrementerButtonBackground">@color/white</item>
        <item name="incrementerButtonBackground">@color/material_light_blue_500</item>

        <!-- Reminder troubleshooting - check contrast before changing -->
        <item name="reminderTroubleshootingOk">@color/google_green_700</item>
        <item name="reminderTroubleshootingWarning">@color/warning_orange</item>


        <item name="badgeErrorColor">#f45000</item>
        <item name="badgeWarningColor">#ff5e13</item>
        <item name="widgetStrokeWidth">0dp</item>
        <item name="widgetStrokeColor">@color/transparent</item>
        <item name="studyScreenElevation">0.8dp</item>
        <item name="whiteboardToolbarCardStyle">?attr/materialCardViewStyle</item>
    </style>

    <style name="Theme_Light" parent="Base.Theme.Light"/>
</resources>

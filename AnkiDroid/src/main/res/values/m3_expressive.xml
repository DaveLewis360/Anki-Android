<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 Expressive design system for AnkiDroid.
    Tonal palette generated from the AnkiDroid brand blue (seed #03A9F4),
    following the M3 Expressive color roles, shape scale and typography.
-->

    <!-- M3 Expressive shape scale: generous, rounded corners -->
    <style name="ShapeAppearance.AnkiDroid.M3Expressive" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.AnkiDroid.M3Expressive.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.AnkiDroid.M3Expressive.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.AnkiDroid.M3Expressive.Large">
